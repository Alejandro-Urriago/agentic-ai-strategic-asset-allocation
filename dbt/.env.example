# Copy this file to dbt/.env and fill in your values. dbt/.env is never shared on GitHub.

# Databricks workspace address: SQL Warehouses > your warehouse > Connection details > Server hostname
DATABRICKS_HOST=

# SQL warehouse address: same tab > HTTP path
DATABRICKS_HTTP_PATH=

# Catalog (top-level data area) where dbt reads and writes
DBT_CATALOG=

# Your personal schema for testing, e.g. dev_<your_name>
DBT_SCHEMA=